{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "api/{**remainder}"
          }
        ]
      },
      "wallet-route": {
        "ClusterId": "wallet-cluster",
        "Match": {
          "Path": "/api/wallet/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "api/{**remainder}"
          }
        ]
      },
      "transactions-route": {
        "ClusterId": "transactions-cluster",
        "Match": {
          "Path": "/api/transactions/{**remainder}"
        },
        "Transforms": [
          {
            "PathPattern": "api/{**remainder}"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5240"
          }
        }
      },
      "wallet-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5145"
          }
        }
      },
      "transactions-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5155"
          }
        }
      }
    }
  }
}